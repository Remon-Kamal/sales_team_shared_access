<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Security Group -->
    <record id="group_sales_team_shared_access" model="res.groups">
        <field name="name">Sales Team Shared Access</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <!-- Record Rule -->
    <record id="sale_order_team_shared_rule" model="ir.rule">
        <field name="name">Sales Orders By Team</field>
        <field name="model_id" ref="sale.model_sale_order"/>

        <field name="domain_force">
            ['|',
                ('team_id.user_id', '=', user.id),
                ('team_id.member_ids', 'in', [user.id])
            ]
        </field>

        <field name="groups" eval="[(4, ref('sales_team_shared_access.group_sales_team_shared_access'))]"/>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>
